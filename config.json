{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 10080,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "d2cb8181-233c-4d18-9972-8a1b04db0044",
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/by_moon"
        },
        "sockopt": {
          "tcpFastOpen": true,
          "tcpKeepAliveInterval": 15
        }
      }
